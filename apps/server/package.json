{
  "name": "@agent-dock/cli",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-ax/agent-dock.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/coding-ax/agent-dock#readme",
  "bugs": {
    "url": "https://github.com/coding-ax/agent-dock/issues"
  },
  "type": "module",
  "bin": {
    "agent-dock": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/agents",
    "dist/assets",
    "dist/vendor",
    "public",
    "scripts/fix-node-pty.mjs",
    "scripts/check-native-compat.mjs"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm --dir ../web build && pnpm build",
    "postinstall": "node scripts/fix-node-pty.mjs && node scripts/check-native-compat.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.66.0",
    "@agentclientprotocol/codex-acp": "1.10.0",
    "@agentclientprotocol/sdk": "1.4.0",
    "@fastify/cors": "10.1.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@openclaw/fs-safe": "0.26.9",
    "acpx": "0.20.0",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "croner": "10.0.1",
    "drizzle-orm": "0.44.2",
    "fastify": "5.4.0",
    "node-pty": "1.2.0-beta.15",
    "pino": "9.7.0",
    "safe-regex2": "5.1.1",
    "ws": "^8.21.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

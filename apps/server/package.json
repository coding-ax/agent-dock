{
  "name": "@agent-dock/cli",
  "version": "0.3.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coding-ax/agent-dock.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/coding-ax/agent-dock#readme",
  "bugs": {
    "url": "https://github.com/coding-ax/agent-dock/issues"
  },
  "type": "module",
  "bin": {
    "agent-dock": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/lark.proto",
    "dist/agents",
    "dist/assets",
    "dist/vendor",
    "public",
    "scripts/fix-node-pty.mjs",
    "scripts/check-native-compat.mjs"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm --dir ../web build && pnpm build",
    "postinstall": "node scripts/fix-node-pty.mjs && node scripts/check-native-compat.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fastify/cors": "11.4.1",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@openclaw/fs-safe": "0.28.0",
    "acpx": "0.20.0",
    "better-sqlite3": "13.0.3",
    "commander": "15.1.0",
    "croner": "11.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "node-pty": "1.2.0-beta.15",
    "pino": "10.4.0",
    "protobufjs": "8.8.1",
    "safe-regex2": "5.1.2",
    "ws": "^8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.106.0",
    "@agentclientprotocol/codex-acp": "2.6.0",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

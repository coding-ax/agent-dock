{
  "name": "@agent-dock/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "AgentDock desktop shell: a native window with the local daemon bundled",
  "main": "src/main.cjs",
  "author": "AgentDock",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "pack:dir": "pnpm prepare:runtime && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "pnpm prepare:runtime && electron-builder --config electron-builder.config.cjs",
    "typecheck": "node --check src/main.cjs && node --check scripts/prepare-runtime.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}

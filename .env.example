AGENTDOCK_HOST=0.0.0.0
AGENTDOCK_PORT=4310
AGENTDOCK_DATABASE_URL=./.agentdock/agentdock.db
AGENTDOCK_DEFAULT_CWD=/absolute/path/to/your/project
AGENTDOCK_DRIVER_IDLE_TIMEOUT_MS=21600000
AGENTDOCK_CLEANUP_INTERVAL_MS=300000

# SSH 远端会话：默认读取 $HOME/.ssh/config，可指向别的 OpenSSH 配置文件。
# AGENTDOCK_SSH_CONFIG=/absolute/path/to/ssh/config

# Sources & Router：P0 支持 GitHub webhook；未配置 Router Agent 时仍可接入、试跑和查看 Case。
AGENTDOCK_SOURCE_BODY_LIMIT_BYTES=1048576
AGENTDOCK_SOURCE_SIGNATURE_TOLERANCE_MS=300000
AGENTDOCK_ROUTER_AGENT_ID=codex
AGENTDOCK_ROUTER_CONFIDENCE_THRESHOLD=0.6
AGENTDOCK_ROUTER_MAX_SESSIONS_PER_CASE=3
AGENTDOCK_ROUTER_MAX_NEW_CASES_PER_HOUR=20
# AGENTDOCK_ROUTER_MODEL_MODE=true
# AGENTDOCK_ROUTER_MODEL=your-small-model
# AGENTDOCK_ROUTER_MAX_ACTIONS_PER_TICK=10
# AGENTDOCK_ROUTER_PAUSED=true
# GITHUB_WEBHOOK_SECRET=replace_me
# GITHUB_TOKEN=replace_me
# AGENTDOCK_GITHUB_API_BASE_URL=http://127.0.0.1:4010

# Optional Lark card channel. Never commit real credentials.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me
LARK_RECEIVE_ID=user@example.com
LARK_RECEIVE_ID_TYPE=email
# Optional group default; when present, takes precedence over LARK_RECEIVE_ID.
# LARK_CHAT_ID=oc_xxx
LARK_AGENT_NAME=AgentDock
# LARK_OPEN_API_BASE_URL=https://open.feishu.cn

# Optional custom agents. Entries with an existing built-in id override it.
# A custom agent must expose an ACP server over stdio, directly or through a bridge.
AGENTDOCK_AGENTS_JSON=[{"id":"custom","name":"Custom ACP Agent","command":"/absolute/path/to/agent","args":["acp","serve"],"protocol":"acp","cwd":"/absolute/path/to/project","env":{},"permissionMode":"ask","timeout":600,"capabilities":{"pause":false,"resume":true},"builtin":false}]
